#!/usr/bin/env bash
# cleanup <version>
# Deletes what a build or release of <version> left behind for this Ubuntu
# version and arch: builder and test servers, their SSH keys, and the image if
# it wasn't promoted to stable. It only matches resources these scripts and
# source.pkr.hcl labelled, and is safe to run at any time.
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname "$0")/lib.sh"

version=${1:?usage: cleanup <version>}
build="purpose in (image-builder,image-smoke-test),version=$version,arch=$arch"

for id in $(hcloud server list --selector "$build" -o noheader -o columns=id); do
  "$(dirname "$0")/delete-server" "$id"
done
for id in $(hcloud ssh-key list --selector "$build" -o noheader -o columns=id); do
  echo "deleting SSH key $id"
  hcloud ssh-key delete "$id" >/dev/null
done
for id in $(hcloud image list --type snapshot --selector "$family,version=$version,channel!=stable" -o noheader -o columns=id); do
  "$(dirname "$0")/delete-image" "$id"
done
