#!/usr/bin/env bash
# find-image <version>
# Prints "<image-id> <size-gb>" for the newest snapshot of that version. The
# size is what Hetzner bills for the snapshot.
set -euo pipefail
# shellcheck source=lib.sh
source "$(dirname "$0")/lib.sh"

version=${1:?usage: find-image <version>}

images=$(hcloud image list --type snapshot --selector "$family,version=$version" -o json)
[[ $(jq length <<<"$images") -gt 0 ]] || die "no snapshot labelled $family,version=$version"
jq -r 'sort_by(.created) | last | "\(.id) \(if .image_size then (.image_size * 100 | round) / 100 else "-" end)"' <<<"$images"
