#!/usr/bin/env bash
# Prints "<tool> <version>" for every tool in the image, one per line. The
# build stores the output in /etc/runner-image/manifest.json, and the smoke
# test runs it again on a new server and compares. Fails if a tool doesn't run.
set -euo pipefail

# version <name> <command...>: prints the first dotted number in the command's output.
version() {
  local name=$1 output number
  shift
  if ! output=$("$@" 2>&1); then
    echo "tool-versions: '$*' failed: $output" >&2
    return 1
  fi
  number=$(grep -oE '[0-9]+(\.[0-9]+)+' <<<"$output" | awk 'NR == 1')
  if [[ -z $number ]]; then
    echo "tool-versions: no version in the output of '$*'" >&2
    return 1
  fi
  echo "$name $number"
}

# The runner writes a log to its _diag directory, so it must run as the runner
# user: a root-owned _diag would stop it from starting later.
as_runner() {
  if [[ $(id -u) -eq 0 ]]; then
    runuser -u runner -- "$@"
  else
    "$@"
  fi
}

