# Pinned versions for the Ubuntu image. The provision scripts source this file.
#
# Renovate (renovate.json) opens a PR when a newer version is released. The
# "# renovate:" comment above each pin says where to look. Apt packages are
# pinned by upstream version; the scripts pick the matching package for the
# Ubuntu release being built.
#
# GitHub stops assigning jobs to a runner 63 days after a newer version becomes
# available. The scheduled CI build fails when RUNNER_VERSION is more than 21 days
# behind (images/ubuntu/check-runner-version.sh), so merge runner PRs soon.

# renovate: datasource=github-releases depName=actions/runner extractVersion=^v(?<version>.+)$
RUNNER_VERSION=2.338.2

# Checked against AWS's signature with files/aws-cli.asc before installing.
# renovate: datasource=github-tags depName=aws/aws-cli
AWS_CLI_VERSION=2.42.2

# Docker's apt repository.
# renovate: datasource=deb depName=docker-ce registryUrl=https://download.docker.com/linux/ubuntu?suite=resolute&components=stable&binaryArch=amd64 extractVersion=^5:(?<version>[0-9.]+)-
DOCKER_VERSION=29.10.0
# renovate: datasource=deb depName=containerd.io registryUrl=https://download.docker.com/linux/ubuntu?suite=resolute&components=stable&binaryArch=amd64 extractVersion=^(?<version>[0-9.]+)-
CONTAINERD_VERSION=2.4.2
# renovate: datasource=deb depName=docker-buildx-plugin registryUrl=https://download.docker.com/linux/ubuntu?suite=resolute&components=stable&binaryArch=amd64 extractVersion=^(?<version>[0-9.]+)-
BUILDX_VERSION=0.39.1
# renovate: datasource=deb depName=docker-compose-plugin registryUrl=https://download.docker.com/linux/ubuntu?suite=resolute&components=stable&binaryArch=amd64 extractVersion=^(?<version>[0-9.]+)-
COMPOSE_VERSION=5.8.0

# Google's apt repository (package google-cloud-cli). Renovate can't read that
# repository's index, so it follows Google's container image, which has the same versions.
# renovate: datasource=docker depName=gcr.io/google.com/cloudsdktool/google-cloud-cli
GCLOUD_VERSION=594.0.1

# Microsoft's apt repository.
# renovate: datasource=deb depName=azure-cli registryUrl=https://packages.microsoft.com/repos/azure-cli?suite=resolute&components=main&binaryArch=amd64 extractVersion=^(?<version>[0-9.]+)-
AZURE_CLI_VERSION=2.93.0

# Not pinned:
# - GitHub CLI (gh): its apt repository only keeps the latest release, so a pin
#   would break the build at every gh release. The manifest records the version.
# - Ubuntu packages (base tools, kernel): the Ubuntu archive only keeps the newest
#   version of each package, and every build should get the latest security fixes.
